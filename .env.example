# =======================================================================
# سامانه جامع مدیریت حوزه علمیه • متغیرهای محیطی استاندارد
# =======================================================================

# ----------------- تنظیمات سرور و برنامه (Application) -----------------
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.runflare.cloud

# ----------------- کلیدهای امنیتی احراز هویت (JWT Secrets) -----------------
# حتماً این کلیدها را با رشته‌های تصادفی و طولانی (حداقل ۶۴ کاراکتر) جایگزین کنید
JWT_SECRET=super-secret-jwt-key-change-this-in-production-64chars-minimum
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-this-in-production-64chars

# ----------------- پایگاه داده رابطه‌ای (MySQL / MariaDB / PostgreSQL) -----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=madrasah_db
DB_USERNAME=root
DB_PASSWORD=

# سازگاری با متغیرهای دیتابیس MySQL مستقیم
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=madrasah_db

# ----------------- سرویس ابری Supabase (اختیاری) -----------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ----------------- تنظیمات فرانت‌اند و Vite -----------------
VITE_BASE_PATH=/
VITE_PORT=3000
VITE_PREVIEW_PORT=4173
DISABLE_HMR=false
