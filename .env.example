# ═══ Application ═══
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
LOG_LEVEL=info

# ═══ Database (MySQL) ═══
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=madrasah_db
DB_USERNAME=root
DB_PASSWORD=

# ═══ JWT (حتماً تغییر بده) ═══
JWT_SECRET=your-64-char-secret-key
JWT_REFRESH_SECRET=your-64-char-refresh-secret

# ═══ Vite (فقط برای build) ═══
VITE_BASE_PATH=/
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
